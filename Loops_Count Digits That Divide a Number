#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
int main() {

    int n;
    scanf("%d",&n);
    int org=n;
    int count=0;
    for(;n>0;n=n/10){
        int digit=n%10;
        if(org%digit==0){
            count++;
        }
    }
    printf("%d",count);
    return 0;
}
